# ===== 基础 =====
# 服务端口（Render 会自动注入 PORT，本地默认 3000）
PORT=3000
# 会话密钥，请改成随机长字符串（部署时在 Render 后台配置）
SESSION_SECRET=change-me-to-a-long-random-secret

# 数据存储目录：本地默认 ./data，Render 上挂持久磁盘可设为 /data
DATA_DIR=./data

# ===== 管理员 =====
# 首次启动会用这两个值创建管理员账号；登录后请立即改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 收款模式 =====
# personal=个人收款码（默认，无需商户资质，买家传支付截图后你手动确认）
# official=微信支付官方 API（需商户号，见下方 WX_* 配置）
PAY_MODE=personal

# ===== 微信支付 APIv3（Native 扫码支付，仅 PAY_MODE=official 时需要）=====
# 已绑定商户的 appid（公众号/小程序/App），Native 支付必需
WX_APPID=
# 商户号
WX_MCHID=
# APIv3 密钥（32 位）
WX_APIV3_KEY=
# 商户 API 证书序列号
WX_SERIAL_NO=
# 商户 API 私钥（apiclient_key.pem 内容）。多行请用 \n 连接，或改用下方文件路径
WX_PRIVATE_KEY=
# 或者指定私钥文件路径（优先于 WX_PRIVATE_KEY）
WX_PRIVATE_KEY_FILE=
# 支付结果回调地址（公网 HTTPS，需已备案）。部署后改为你的 Render 域名
WX_NOTIFY_URL=

# ===== 店铺信息（也可在后台设置里改）=====
STORE_NAME=我的小店
STORE_NOTICE=欢迎光临，下单后微信扫码付款即可
