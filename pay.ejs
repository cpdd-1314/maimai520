<%- include('../partials/shop_head', { title: '订单支付', store: settings }) %>
<div class="container pay">
  <h1 class="page-title">订单支付</h1>
  <div class="order-box">
    <p>商品：<b><%= order.productName %></b> ×<%= order.quantity %></p>
    <p class="price big">应付：¥<%= formatYuan(order.amount) %></p>
    <p class="muted">订单号：<%= order.outTradeNo %></p>
  </div>

  <% if (message) { %><p class="warn"><%= message %></p><% } %>

  <% if (configured && qr) { %>
    <div class="qr"><img src="<%= qr %>" alt="微信支付二维码"></div>
    <p class="hint">请用微信「扫一扫」完成支付，支付成功后本页会自动跳转。</p>
    <script>
      (function () {
        var no = '<%= order.outTradeNo %>';
        var timer = setInterval(function () {
          fetch('/api/order/' + no + '/status')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d && d.paid) { clearInterval(timer); location.reload(); }
            })
            .catch(function () {});
        }, 3000);
      })();
    </script>
  <% } %>
</div>
<%- include('../partials/shop_foot') %>
