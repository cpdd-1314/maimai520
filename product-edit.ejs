<%- include('../partials/admin_head', { title }) %>
<h1 class="page-title">编辑商品</h1>
<% if (typeof error !== 'undefined' && error) { %><p class="warn"><%= error %></p><% } %>
<section class="panel">
  <form method="POST" action="/admin/products/<%= product.id %>/edit" enctype="multipart/form-data" class="grid-form">
    <label>名称<input type="text" name="name" required maxlength="100" value="<%= product.name %>"></label>
    <label>价格（元）<input type="number" step="0.01" name="price" required min="0" value="<%= (product.price/100).toFixed(2) %>"></label>
    <label>库存（留空表示不限）<input type="number" name="stock" min="0" value="<%= product.stock == null ? '' : product.stock %>" placeholder="不限"></label>
    <label>排序（大靠前）<input type="number" name="sort" value="<%= product.sort || 0 %>"></label>
    <label>状态
      <select name="status">
        <option value="on" <%= product.status === 'on' ? 'selected' : '' %>>在售</option>
        <option value="off" <%= product.status === 'off' ? 'selected' : '' %>>下架</option>
      </select>
    </label>
    <label>图片<% if (product.image) { %><img class="thumb" src="<%= product.image %>"><% } else { %><span class="muted">无</span><% } %><input type="file" name="image" accept="image/*"></label>
    <label class="full chk"><input type="checkbox" name="removeImage" value="1"> 移除当前图片</label>
    <label class="full">描述<textarea name="description" rows="3" maxlength="2000"><%= product.description %></textarea></label>
    <button class="btn" type="submit">保存</button>
    <a class="btn" href="/admin/products">返回</a>
  </form>
</section>
<%- include('../partials/admin_foot') %>
